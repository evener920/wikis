\u5929 \u8499\u66fc 21% \u968b\u5510\u5236\u5ea6\u6e0a\u6e90\u7565\u8bba\u7a3f \u9648\u5bc5\u606a \u5df2\u8bfb","tags":["\u5386\u53f2","\u8bfb\u4e66","\u5510\u53f2"]},{"location":"reading-notes/tang-history/#_3","title":"\u6458\u8bb0","text":"<ul> <li>\u5236\u5ea6\u53f2\u770b\u91cd\u300c\u6e0a\u6e90\u300d\u800c\u975e\u300c\u65ad\u4ee3\u300d</li> <li>\u6b66\u5219\u5929\u79f0\u5236\u524d\u7684\u6743\u529b\u7ed3\u6784\u6f14\u53d8\u503c\u5f97\u7ec6\u8bfb</li> </ul>","tags":["\u5386\u53f2","\u8bfb\u4e66","\u5510\u53f2"]},{"location":"research-notes/rag-publishing/","title":"RAG \u77e5\u8bc6\u5e93\u8d4b\u80fd\u4e13\u4e1a\u51fa\u7248","text":"<p>\u8fd9\u662f\u4e00\u7bc7\u793a\u4f8b\u6587\u6863\uff0c\u6f14\u793a\u300c\u5206\u7c7b + \u6807\u7b7e\u300d\u7684\u5199\u6cd5\u3002\u66ff\u6362\u6210\u4f60\u81ea\u5df1\u7684\u5185\u5bb9\u5373\u53ef\u3002</p>","tags":["RAG","\u51fa\u7248","\u8bba\u6587","\u77e5\u8bc6\u5e93"]},{"location":"research-notes/rag-publishing/#_1","title":"\u6458\u8981","text":"<p>\u5782\u76f4\u9886\u57df\u51fa\u7248\u5bf9\u5185\u5bb9\u7cbe\u51c6\u5ea6\u8981\u6c42\u6781\u9ad8\u3002RAG\uff08\u68c0\u7d22\u589e\u5f3a\u751f\u6210\uff09\u901a\u8fc7\u628a\u9886\u57df\u77e5\u8bc6\u5e93 \u63a5\u5165\u5927\u6a21\u578b\uff0c\u5728\u751f\u6210\u65f6\u68c0\u7d22\u6743\u5a01\u8d44\u6599\uff0c\u663e\u8457\u964d\u4f4e\u5e7b\u89c9\u7387\u3002</p>","tags":["RAG","\u51fa\u7248","\u8bba\u6587","\u77e5\u8bc6\u5e93"]},{"location":"research-notes/rag-publishing/#_2","title":"\u6838\u5fc3\u8981\u70b9","text":"<ol> <li>\u77e5\u8bc6\u5e93\u6784\u5efa\uff1a\u6e05\u6d17\u3001\u5207\u5206\u3001\u5411\u91cf\u5316\u9886\u57df\u6587\u732e</li> <li>\u68c0\u7d22\u94fe\u8def\uff1aquery \u6539\u5199 \u2192 \u6df7\u5408\u68c0\u7d22 \u2192 \u91cd\u6392</li> <li>\u751f\u6210\u7ea6\u675f\uff1a\u5f15\u7528\u6eaf\u6e90\u3001\u53ef\u6838\u67e5</li> </ol> <p>\u6807\u7b7e\u600e\u4e48\u6765\u7684</p> <p>\u672c\u6587\u5934\u90e8\u7684 <code>tags: [RAG, \u51fa\u7248, \u8bba\u6587, \u77e5\u8bc6\u5e93]</code> \u4f1a\u88ab\u81ea\u52a8\u6c47\u603b\u5230 \u6807\u7b7e\u603b\u89c8 \u9875\u9762\uff0c\u70b9\u8fdb\u53bb\u80fd\u770b\u5230\u6240\u6709\u5e26\u8be5\u6807\u7b7e\u7684\u6587\u7ae0\u3002</p> <pre><code># \u793a\u4f8b\uff1a\u6700\u7b80\u5355\u7684\u68c0\u7d22\u7247\u6bb5\ndef retrieve(query, index, top_k=3):\n    return index.search(query, top_k)\n</code></pre>","tags":["RAG","\u51fa\u7248","\u8bba\u6587","\u77e5\u8bc6\u5e93"]},{"location":"%E8%AF%97%E8%AF%8D/","title":"\u8bd7\u8bcd","text":"<p>\u8fd9\u91cc\u6536\u96c6\u559c\u7231\u7684\u8bd7\u8bcd\u4e0e\u7ecf\u5178\u6458\u5f55\u3002</p>"},{"location":"%E8%AF%97%E8%AF%8D/#_2","title":"\u793a\u4f8b","text":"<p>\u5e8a\u524d\u660e\u6708\u5149\uff0c\u7591\u662f\u5730\u4e0a\u971c\u3002 \u4e3e\u5934\u671b\u660e\u6708\uff0c\u4f4e\u5934\u601d\u6545\u4e61\u3002</p> <p>\u2014\u2014\u674e\u767d\u300a\u9759\u591c\u601d\u300b</p> <p>\u628a\u65b0\u7684\u8bd7\u8bcd\u5199\u6210 <code>.md</code> \u6587\u4ef6\u62d6\u8fdb\u8fd9\u4e2a\u6587\u4ef6\u5939\u5373\u53ef\u81ea\u52a8\u51fa\u73b0\u5728\u4fa7\u8fb9\u680f\u3002</p>"}]}